{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipboard",
  "version": "0.2.3",
  "identifier": "com.lyz.clipboard-manager-tauri",
  "mainBinaryName": "clipboard-manager-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd src-tauri && cargo build --release --example sms-helper && copy /Y target\\release\\examples\\sms-helper.exe identity\\sms-helper.exe",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "identity/clipboard-identity.msix",
      "identity/clipboard-identity.cer",
      "identity/sms-helper.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
